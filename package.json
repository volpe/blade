{
  "name": "blade",
  "version": "0.6.0",
  "private": true,
  "description": "Shared product-engineering workflows and adaptive expert teams for Codex, pi, Grok, and Claude Code.",
  "author": "volpe",
  "repository": {
    "type": "git",
